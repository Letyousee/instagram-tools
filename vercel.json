{
  "version": 2,
  "name": "instagram-engagement-api",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)\.html$",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)\.css$",
      "dest": "/$1.css"
    },
    {
      "src": "/(.*)\.js$",
      "dest": "/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "RAPIDAPI_KEY": "@rapidapi-key"
  },
  "regions": ["iad1"]
}
